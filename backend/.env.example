# Default: SQLite file, zero setup, good for the demo/prototype.
DATABASE_URL=sqlite:///./coopera.db
# To use Postgres instead (docker compose up -d db), uncomment:
# DATABASE_URL=postgresql+psycopg://coopera:coopera@localhost:5432/coopera
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173

# Must match what the frontend is actually served from — used to build the
# redirect back to the admin panel after the Mercado Pago OAuth flow, and in
# the Checkout Pro back_urls.
FRONTEND_BASE_URL=http://localhost:5173

# Mercado Pago OAuth "Connect" app. Create one at
# https://www.mercadopago.com.ar/developers/panel/app (any existing MP
# account works for creating the app). Register PUBLIC_BASE_URL +
# /api/mp/oauth/callback as the app's redirect URI. One app for the whole
# Coopera deployment; each cooperativa then connects their own MP account to
# it from the admin panel — payments settle to them, not to Coopera.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
