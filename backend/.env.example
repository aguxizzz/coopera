# Default: SQLite file, zero setup, good for the demo/prototype.
DATABASE_URL=sqlite:///./coopero.db
# To use Postgres instead (docker compose up -d db), uncomment:
# DATABASE_URL=postgresql+psycopg://coopero:coopero@localhost:5432/coopero
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173
